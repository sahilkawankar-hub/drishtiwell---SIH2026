# eRTMAC-NWIS Backend Environment Configuration
# Copy this to .env and fill in your values

# ---------------------------------------------
# DATABASE
# ---------------------------------------------
# SQLite (local dev - default)
DATABASE_URL="file:./dev.db"

# PostgreSQL/Supabase (production)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ---------------------------------------------
# SERVER
# ---------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------
# SECURITY
# ---------------------------------------------
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# ---------------------------------------------
# AI SERVICE (optional - connect when ready)
# ---------------------------------------------
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=gemini
# GOOGLE_AI_API_KEY=...
# AI_PROVIDER=demo  # Uses deterministic demo responses (default)
AI_PROVIDER=demo

# ---------------------------------------------
# OCR/DOCUMENT SERVICE (optional)
# ---------------------------------------------
# OCR_PROVIDER=google_document_ai
# GOOGLE_DOCUMENT_AI_KEY=...
# OCR_PROVIDER=demo  # Uses demo extraction (default)
OCR_PROVIDER=demo

# ---------------------------------------------
# LOGGING
# ---------------------------------------------
LOG_LEVEL=info
